+
+def test_what_if_without_changes(client, monkeypatch):
+    fake_llm(monkeypatch, intent="what_if", changes={})
+    assert ask(client, "조건 바꾸면요?") == {"answer": chat_graph.NO_CHANGE_ANSWER}
